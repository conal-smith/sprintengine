{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts",
    "packages/module-sdk/src/**/*.ts",
    "packages/conversation-protocol/src/**/*.ts",
    "packages/conversation-protocol/test/**/*.ts",
    "packages/conversation-timeline/src/**/*.ts",
    "packages/conversation-timeline/test/**/*.ts",
    "packages/conversation-view/src/**/*.ts",
    "packages/conversation-view/src/**/*.tsx",
    "packages/conversation-view/test/**/*.tsx",
    "packages/studio-protocol/src/**/*.ts",
    "packages/studio-protocol/test/**/*.ts",
    "packages/connection-supervisor/src/**/*.ts",
    "packages/connection-supervisor/test/**/*.ts",
    "packages/agent-sdk/src/**/*.ts",
    "packages/agent-sdk/test/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts"
  ],
  "compilerOptions": {
    "composite": true,
    // @electron-toolkit/tsconfig turns noImplicitAny OFF after setting strict, so
    // every un-annotated parameter was silently `any` until this line. Kept here
    // rather than in the vendored base, which npm rewrites.
    "noImplicitAny": true,
    "moduleResolution": "bundler",
    "types": ["node", "vite/client"],
    "paths": {
      "@renderer/*": ["./src/renderer/src/*"]
    }
  }
}
