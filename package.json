{
  "name": "sprintengine-studio",
  "version": "0.4.0",
  "description": "Agent-first desktop IDE that runs coding agent CLIs across parallel workspaces.",
  "author": "SprintEngine",
  "license": "MIT",
  "private": true,
  "main": "./out/main/index.js",
  "homepage": "https://sprintengine.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sprintengine/studio.git"
  },
  "bugs": {
    "url": "https://github.com/sprintengine/studio/issues"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "start": "node scripts/dev.js",
    "dev": "node scripts/dev.js",
    "build": "electron-vite build",
    "build:server": "node scripts/build-server.mjs",
    "build:server:wsl": "node scripts/build-server.mjs --wsl",
    "build:web": "vite build --config vite.web.config.ts",
    "build:sdk": "tsc -p packages/module-sdk/tsconfig.json",
    "build:conversation-protocol": "node packages/conversation-protocol/build.mjs",
    "build:studio-protocol": "node packages/studio-protocol/build.mjs",
    "build:agent-sdk": "node packages/agent-sdk/build.mjs",
    "dist": "npm run runtimes:fetch && npm run sdk:bundle && npm run build && npm run build:server:wsl && electron-builder",
    "dist:win": "npm run runtimes:fetch -- --platform win32 && npm run sdk:bundle && npm run build && npm run build:server:wsl && electron-builder --win",
    "dist:mac": "npm run runtimes:fetch -- --platform darwin && npm run sdk:bundle && npm run build && npm run build:server:wsl && electron-builder --mac",
    "dist:linux": "npm run runtimes:fetch -- --platform linux && npm run sdk:bundle && npm run build && npm run build:server:wsl && electron-builder --linux",
    "runtimes:fetch": "node scripts/fetch-runtimes.mjs",
    "sdk:bundle": "node scripts/pack-module-sdk.mjs",
    "icons": "node scripts/generate-icons.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:sdk:drift": "tsc -p packages/module-sdk/tsconfig.json && tsc -p packages/module-sdk/tsconfig.drift.json && esbuild packages/module-sdk/drift/sdk-drift-guard.ts --bundle --platform=node --format=cjs --packages=external --outfile=node_modules/.cache/sprintengine/sdk-drift-guard.cjs && node node_modules/.cache/sprintengine/sdk-drift-guard.cjs",
    "test:sdk:pack": "node scripts/verify-module-sdk-pack.mjs",
    "test:conversation-protocol:pack": "node scripts/verify-conversation-protocol-pack.mjs",
    "test:studio-packages:pack": "node scripts/verify-studio-packages-pack.mjs",
    "test:card-feed": "node scripts/check-card-feed-seed.mjs",
    "test:sources": "node scripts/check-sources-seed.mjs",
    "test:release": "node --test scripts/release/*.test.mjs",
    "codex:protocol": "node scripts/generate-codex-protocol.mjs",
    "typecheck": "npm run typecheck:app",
    "typecheck:app": "tsc -b --noEmit --verbose",
    "typecheck:tests": "tsc -b tsconfig.tests.json --noEmit --verbose",
    "typecheck:all": "npm run typecheck:app && npm run typecheck:tests",
    "verify:app": "npm run typecheck:all && npm run lint && npm run format:check && npm run knip && npm run test && npm run test:sdk:drift && npm run test:sdk:pack && npm run test:conversation-protocol:pack && npm run test:studio-packages:pack && npm run test:card-feed && npm run test:sources && npm run test:release",
    "verify:marketplace-registry": "esbuild resources/marketplace/verify-marketplace.ts --bundle --platform=node --format=cjs --packages=external --outfile=node_modules/.cache/sprintengine/marketplace-registry-verify.cjs && node node_modules/.cache/sprintengine/marketplace-registry-verify.cjs",
    "lint": "oxlint && node scripts/lint-nul-bytes.mjs && node scripts/lint-design-tokens.mjs && node scripts/lint-panel-composition.mjs && node scripts/lint-primitive-duplication.mjs && node scripts/lint-door-surfaces.mjs && node scripts/lint-design-system-conformance.mjs && node scripts/testing/design-system-guard-probes.mjs",
    "lint:code": "oxlint",
    "format": "prettier --write \"*.ts\" \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\" \"packages/*/{src,test,drift,examples}/**/*.{ts,tsx}\" \"scripts/**/*.{js,mjs,cjs}\" \"design-system/scripts/**/*.mjs\"",
    "test:web:smoke": "node scripts/web-smoke.mjs",
    "format:check": "prettier --check \"*.ts\" \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\" \"packages/*/{src,test,drift,examples}/**/*.{ts,tsx}\" \"scripts/**/*.{js,mjs,cjs}\" \"design-system/scripts/**/*.mjs\"",
    "knip": "knip --include files,dependencies,unlisted,binaries --no-config-hints",
    "knip:exports": "knip --include exports,types,duplicates",
    "lint:nul-bytes": "node scripts/lint-nul-bytes.mjs",
    "lint:design-tokens": "node scripts/lint-design-tokens.mjs",
    "lint:design-tokens:report": "node scripts/lint-design-tokens.mjs --report",
    "lint:panel-composition": "node scripts/lint-panel-composition.mjs",
    "lint:panel-composition:report": "node scripts/lint-panel-composition.mjs --report",
    "lint:primitive-duplication": "node scripts/lint-primitive-duplication.mjs",
    "lint:primitive-duplication:report": "node scripts/lint-primitive-duplication.mjs --report",
    "lint:door-surfaces": "node scripts/lint-door-surfaces.mjs",
    "lint:design-system-conformance": "node scripts/lint-design-system-conformance.mjs",
    "lint:guard-probes": "node scripts/testing/design-system-guard-probes.mjs",
    "catalogue:cli-entries": "esbuild resources/marketplace/generate-cli-entries.ts --bundle --platform=node --format=cjs --packages=external --outfile=node_modules/.cache/sprintengine/marketplace-cli-entries-generate.cjs && node node_modules/.cache/sprintengine/marketplace-cli-entries-generate.cjs",
    "measure:startup": "node scripts/measure-startup.mjs",
    "measure:typeable": "node scripts/measure-time-to-typeable.mjs",
    "smoke:server-mode": "node scripts/smoke-server-mode.mjs",
    "report:source-size": "node scripts/report-source-size.mjs",
    "postinstall": "node scripts/fix-node-pty-permissions.js && node node_modules/electron/install.js"
  },
  "build": {
    "appId": "com.sprintengine.studio",
    "productName": "SprintEngine Studio",
    "directories": {
      "output": "dist"
    },
    "artifactName": "SprintEngine-Studio-${version}-${os}-${arch}.${ext}",
    "electronLanguages": [
      "en",
      "de",
      "fr",
      "es",
      "pt",
      "ja",
      "zh",
      "ko",
      "it",
      "ru"
    ],
    "files": [
      "out/**/*",
      "!out/**/*.map",
      "!out/server/**",
      "!out/wsl-server/**",
      "!out/web/**",
      "!node_modules/@anthropic-ai/claude-agent-sdk-*/**",
      "!node_modules/**/*.{map,d.ts,d.mts,d.cts}",
      "!node_modules/**/!(LICENSE*|LICENCE*|license*|licence*).md",
      "!node_modules/**/*.test.js",
      "!node_modules/zod/src{,/**/*}",
      "!node_modules/docx/dist/{charts,html,layout,macros,math,shapes,watermarks}.*",
      "!node_modules/docx/dist/index.{mjs,iife.js,umd.cjs,d.ts,d.cts}"
    ],
    "asarUnpack": [
      "node_modules/@vscode/ripgrep-*/bin/**"
    ],
    "extraResources": [
      {
        "from": "resources/runtime",
        "to": "runtime",
        "filter": [
          "npm/**/*",
          "!npm/docs{,/**/*}",
          "!npm/man{,/**/*}"
        ]
      },
      {
        "from": "resources/automation",
        "to": "automation",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/studio-plugin",
        "to": "studio-plugin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/builtin-skills",
        "to": "builtin-skills",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/artifacts-site",
        "to": "artifacts-site",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "packages/module-sdk/templates",
        "to": "sdk-templates",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "packages/module-sdk/skills",
        "to": "sdk-skills",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/module-sdk",
        "to": "module-sdk",
        "filter": [
          "*.tgz"
        ]
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      },
      {
        "from": "resources/cards-feed.json",
        "to": "cards-feed.json"
      },
      {
        "from": "resources/sources.json",
        "to": "sources.json"
      },
      {
        "from": "resources/wsl-helper",
        "to": "wsl-helper",
        "filter": [
          "**/*.mjs"
        ]
      },
      {
        "from": "resources/hooks",
        "to": "hooks",
        "filter": [
          "**/*.mjs"
        ]
      },
      {
        "from": "resources/marketplace",
        "to": "marketplace",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/plugins",
        "to": "plugins",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/design-system",
        "to": "design-system",
        "filter": [
          "templates/**"
        ]
      },
      {
        "from": "out/wsl-server",
        "to": "wsl-server",
        "filter": [
          "**/*"
        ]
      }
    ],
    "afterSign": "./scripts/release/notarize-mac.mjs",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "resources/icon.icns",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "notarize": false,
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "SprintEngine Studio uses your local network to reach your SSH machines and the devices you pair with it, to preview servers running on this Mac or nearby, and for the commands your terminals and agents run.",
        "NSAutoFillRequiresTextContentTypeForOneTimeCodeOnMac": true
      }
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.png",
      "category": "Development"
    },
    "toolsets": {
      "appimage": "1.0.3"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "include": "build/installer.nsh",
      "installerHeaderIcon": "resources/icon.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "sprintengine",
      "repo": "studio",
      "releaseType": "release"
    },
    "protocols": [
      {
        "name": "SprintEngine Studio",
        "schemes": [
          "sprintengine"
        ],
        "role": "Viewer"
      }
    ]
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.9.0",
    "@anthropic-ai/claude-agent-sdk": "0.3.306",
    "@vscode/ripgrep": "^1.18.0",
    "@xterm/addon-serialize": "0.15.0-beta.300",
    "@xterm/addon-unicode11": "0.10.0-beta.300",
    "@xterm/headless": "6.1.0-beta.303",
    "docx": "^9.13.0",
    "electron-updater": "^6.8.11",
    "ignore": "7.0.13",
    "node-pty": "^1.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron/asar": "^4.3.1",
    "@electron/notarize": "^3.1.2",
    "@excalidraw/excalidraw": "0.18.1",
    "@excalidraw/mermaid-to-excalidraw": "2.2.2",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@legendapp/list": "3.6.0",
    "@lezer/common": "^1.5.3",
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/hast": "3.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "@xterm/addon-clipboard": "0.3.0-beta.302",
    "@xterm/addon-fit": "0.12.0-beta.300",
    "@xterm/addon-search": "0.17.0-beta.300",
    "@xterm/addon-web-links": "0.13.0-beta.300",
    "@xterm/addon-webgl": "0.20.0-beta.299",
    "@xterm/xterm": "6.1.0-beta.303",
    "axe-core": "^4.14.0",
    "diff": "9.0.0",
    "dompurify": "^3.4.17",
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "6.0.0",
    "esbuild": "^0.28.2",
    "flexlayout-react": "^0.11.1",
    "immer": "^11.2.3",
    "jsdom": "^30.1.3",
    "katex": "^0.19.0",
    "knip": "6.42.1",
    "mermaid": "~11.13.0",
    "monaco-editor": "^0.57.0",
    "nanoid": "^6.0.2",
    "oxlint": "1.89.0",
    "playwright-core": "^1.64.1",
    "prettier": "3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "shiki": "4.5.0",
    "tailwindcss": "^4.0.6",
    "typescript": "^7.0.2",
    "unified": "^11.0.5",
    "vite": "^8.3.4",
    "vitest": "5.0.5",
    "zustand": "^5.0.15"
  },
  "overrides": {
    "@excalidraw/excalidraw": {
      "@radix-ui/react-tabs": "^1.1.21",
      "nanoid": "^3.3.19"
    },
    "@excalidraw/mermaid-to-excalidraw": {
      "@mermaid-js/parser": "^1.2.1",
      "nanoid": "^5.1.16"
    },
    "@xmldom/xmldom": "^0.8.15",
    "lodash-es": "^4.18.1",
    "mermaid": "~11.13.0"
  }
}
