{
  "name": "@sprintengine/conversation-timeline",
  "version": "0.1.0",
  "description": "A SprintEngine Studio conversation as rows a view draws: the projection of its events, the timeline, and a follower that keeps both current over a Studio connection. No React, DOM or Electron.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conal-smith/sprintengine.git",
    "directory": "packages/conversation-timeline"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "./dist/cjs/public.js",
  "module": "./dist/esm/public.js",
  "types": "./dist/cjs/public.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/public.d.ts",
        "default": "./dist/esm/public.js"
      },
      "require": {
        "types": "./dist/cjs/public.d.ts",
        "default": "./dist/cjs/public.js"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dependencies": {
    "@sprintengine/conversation-protocol": "^0.2.0"
  },
  "scripts": {
    "build": "node build.mjs",
    "prepack": "npm run build"
  }
}
