{
  "name": "@sprintengine/module-sdk",
  "version": "1.0.0-beta.1",
  "description": "Contract types, templates and authoring CLI for building SprintEngine Studio extensions: manifest and host API version, MainHost/RendererHost contributions, chat conversations with the app's agents, brokered secrets and GitHub access, Automations providers, notifications, and signing.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conal-smith/sprintengine.git",
    "directory": "packages/module-sdk"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22.15"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./signing": {
      "types": "./dist/signing.d.ts",
      "default": "./dist/signing.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "default": "./dist/ui.js"
    },
    "./surface": {
      "types": "./dist/surface.d.ts",
      "default": "./dist/surface.js"
    },
    "./scaffold": {
      "types": "./dist/scaffold.d.ts",
      "default": "./dist/scaffold.js"
    },
    "./guide": {
      "types": "./dist/guide.d.ts",
      "default": "./dist/guide.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./testing/kit": {
      "types": "./dist/testing-kit.d.ts",
      "default": "./dist/testing-kit.js"
    },
    "./testing/register": {
      "types": "./dist/testing-register.d.ts",
      "default": "./dist/testing-register.js"
    }
  },
  "bin": {
    "sprintengine-module": "./dist/cli.js"
  },
  "files": [
    "dist",
    "guide",
    "templates",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@types/react": ">=18",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
