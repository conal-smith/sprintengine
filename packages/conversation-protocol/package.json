{
  "name": "@sprintengine/conversation-protocol",
  "version": "0.2.0",
  "description": "The conversation contract SprintEngine Studio speaks to everything that follows or drives its chats: events, commands, frames, capabilities and their validators.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conal-smith/sprintengine.git",
    "directory": "packages/conversation-protocol"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "./dist/cjs/public.js",
  "module": "./dist/esm/public.js",
  "types": "./dist/cjs/public.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/esm/public.d.ts", "default": "./dist/esm/public.js" },
      "require": { "types": "./dist/cjs/public.d.ts", "default": "./dist/cjs/public.js" }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": ["dist", "README.md", "CHANGELOG.md", "LICENSE"],
  "scripts": { "build": "node build.mjs", "prepack": "npm run build" }
}
