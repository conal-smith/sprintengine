{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "renderer.vite.config.*",
    "vite.web.config.*",
    "src/main/**/*",
    "src/server/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "src/renderer/src/types/appTheme.ts",
    "src/renderer/src/types/workspace.ts",
    "packages/module-sdk/src/**/*",
    "packages/conversation-timeline/src/**/*",
    "packages/conversation-protocol/src/**/*",
    "packages/studio-protocol/src/**/*",
    "packages/connection-supervisor/src/**/*",
    "packages/agent-sdk/src/**/*"
  ],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "packages/**/*.test.ts"],
  "compilerOptions": {
    "composite": true,
    // @electron-toolkit/tsconfig turns noImplicitAny OFF after setting strict, so
    // every un-annotated parameter was silently `any` until this line. Kept here
    // rather than in the vendored base, which npm rewrites.
    "noImplicitAny": true,
    "moduleResolution": "bundler",
    "types": ["electron-vite/node"]
  }
}
