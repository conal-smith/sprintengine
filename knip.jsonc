{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // The main and preload entries come from electron.vite.config.ts; these are
  // the rest: the three renderer documents and the scripts the package.json
  // scripts and workflows run by path.
  "entry": [
    "src/renderer/index.html",
    "src/renderer/splash.html",
    "src/renderer/canvas-worker.html",
    // The web client's build (vite.web.config.ts, on the renderer config both
    // builds share): the pairing page, and the modules it swaps in for a
    // browser — the tab's window.api, Electron's stand-in and the IPC router.
    "vite.web.config.ts",
    "renderer.vite.config.ts",
    "src/renderer/pair.html",
    "src/renderer/src/web/pair/pairPage.ts",
    "src/renderer/embed.html",
    "src/renderer/src/web/embed/embedMain.tsx",
    "src/renderer/src/web/installWebApi.ts",
    "src/renderer/src/web/electronShim.ts",
    "src/renderer/src/web/webIpcRouter.ts",
    "scripts/**/*.{js,mjs,cjs}",
    "design-system/scripts/*.mjs",
    "resources/marketplace/*.ts",
    "resources/hooks/*.mjs",
    // The WSL helper runs inside Linux on its own Node; main installs it there.
    "resources/wsl-helper/**/*.mjs",
    "packages/module-sdk/src/cli.ts",
    // The SDK's `./testing/register` entry: a module's tests load it with
    // `node --import`, so nothing in this repository imports it.
    "packages/module-sdk/src/testing-register.ts",
    "packages/module-sdk/drift/*.ts",
    // The standalone Studio server, bundled by scripts/build-server.mjs.
    "src/server/main.ts",
    // The protocol packages' published entries; app code imports their files directly.
    "packages/conversation-protocol/src/public.ts",
    "packages/studio-protocol/src/public.ts",
    // The agent SDK's published entries, the client and its Node half.
    "packages/agent-sdk/src/index.ts",
    "packages/agent-sdk/src/node.ts",
    // The conversation timeline's and view's published entries.
    "packages/conversation-timeline/src/public.ts",
    "packages/conversation-view/src/public.ts",
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "scripts/**/*.{js,mjs,cjs}",
    "packages/*/src/**/*.ts",
    "resources/marketplace/*.ts",
    "tests/**/*.ts",
  ],
  "ignore": [
    // Scaffold sources: copied into an author's own project, whose package.json
    // depends on @sprintengine/module-sdk. They are not part of this one.
    "packages/module-sdk/templates/**",
    "packages/module-sdk/skills/**",
    "resources/studio-plugin/sprintengine-studio/skills/sprintengine-extension-builder/**",
  ],
  "ignoreBinaries": [
    // The Windows system launcher for a WSL distribution: it lists the
    // distributions and starts each one's helper. Not an npm binary.
    "wsl.exe",
    // The POSIX tool clone-tree.test.ts makes a FIFO with; Node has no API for it.
    "mkfifo",
    // The POSIX disk-usage tool Settings ▸ Worktrees measures worktrees with
    // (worktree-pool/disk-usage.ts). Not an npm binary.
    "du",
    // The Windows registry tool; the updater reads where an all-users
    // installation is recorded with it. Not an npm binary.
    "reg.exe",
    // The Windows ACL tool; the server's secret key file is made the current
    // user's only with it. Not an npm binary.
    "icacls",
    // OpenSSH's own tools: the SSH machine suites make a throwaway key and
    // wait for a container's sshd with them. Not npm binaries.
    "ssh-keygen",
    "ssh-keyscan",
    // The shell linter the install-script suites run every generated script
    // through, where it is installed. Not an npm binary.
    "shellcheck",
    // Hyprland's control tool: the entry asks it for the compositor's version
    // before the app is ready (hyprland-color-manager.ts). Not an npm binary.
    "hyprctl",
  ],
  "ignoreDependencies": [
    // Imported from CSS (`@import "tailwindcss"`), which knip does not read.
    "tailwindcss",
    // The bundled UI and mono faces, imported from index.css for the same reason.
    "@fontsource/inter",
    "@fontsource/jetbrains-mono",
    // The pack check installs the freshly packed tarball and imports it by name.
    "@sprintengine/conversation-protocol",
  ],
}
