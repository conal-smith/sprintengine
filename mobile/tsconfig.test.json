// The regression suite runs on bare Node, so it compiles to CommonJS. React
// Navigation ships ESM-only, which CommonJS emit cannot `require` — and the
// tests never touch it. So this build takes only the logic modules the tests
// load as entry points; TypeScript pulls in their transitive imports.
//
// `npm run typecheck` still type-checks the whole app, navigators included.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "node16",
    "jsx": "react-jsx",
    "noEmit": false,
    "outDir": ".mobile-test-build",
    "rootDir": "."
  },
  "include": [
    "src/api/tailnetControlClient.ts",
    "src/api/tailnetTransport.ts",
    "src/api/conversationWire.ts",
    "src/api/tailnetConversations.ts",
    "src/api/conversationLaunch.ts",
    "src/api/conversationImages.ts",
    "src/api/conversationLifecycle.ts",
    "src/api/scheduledAgents.ts",
    "src/features/scheduled/scheduleEditor.ts",
    "src/features/scheduled/schedulePick.ts",
    "src/features/scheduled/sendTime.ts",
    "src/shared/cron/cron.ts",
    "src/api/tailnetWorkspaces.ts",
    "src/components/document/htmlSandbox.ts",
    "src/components/document/tableLayout.ts",
    "src/components/document/sourceHighlight.ts",
    "src/components/document/markdownRuns.ts",
    "src/components/document/rich/replyMarkup.ts",
    "src/components/document/rich/svgSanitizer.ts",
    "src/components/document/rich/diagramSource.ts",
    "src/components/document/rich/richRenderer.ts",
    "src/components/formatTimestamp.ts",
    "src/components/glyphs/lifecycleTone.ts",
